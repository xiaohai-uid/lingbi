# =============================================================================
# 通用 Node.js 微服务 Dockerfile（参数化）
#
# 适用于 settings（入口 service.js）与 canvas（入口 index.js）两个服务。
#
# 构建上下文为对应微服务目录（microservices/settings 或 microservices/canvas），
# Dockerfile 自身位于 lingbi_server/docker/Dockerfile.node（由 compose 的
# dockerfile: ../../docker/Dockerfile.node 引用）。
#
# 构建参数（通过 docker-compose build.args 注入）：
#   ENTRY_SCRIPT - 启动脚本，settings 为 service.js，canvas 为 index.js
#   PORT         - 监听端口（settings=8087，canvas=8091）
#
# 注：审计发现两个 Node 服务均无 package-lock.json，故使用 npm install 而非 npm ci。
# =============================================================================

FROM node:20-slim

ARG ENTRY_SCRIPT=index.js
ARG PORT=8080

WORKDIR /app

# 先复制依赖清单以利用 Docker 层缓存
COPY package*.json ./

# 无 package-lock.json，使用 npm install；--omit=dev 跳过 devDependencies
RUN npm install --omit=dev

# 复制服务全部源码（含本地模块与静态资源）
COPY . .

# 创建非 root 用户并赋权
RUN useradd -m -u 1001 nodeuser && \
    chown -R nodeuser:nodeuser /app

USER nodeuser

# 将构建参数提升为运行时环境变量
ENV ENTRY_SCRIPT=$ENTRY_SCRIPT
ENV PORT=$PORT

EXPOSE $PORT

# 健康检查（端口从运行时 PORT 环境变量读取）
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://localhost:' + (process.env.PORT || '8080') + '/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1) })"

# shell 形式以展开 $ENTRY_SCRIPT 环境变量
CMD node "$ENTRY_SCRIPT"
