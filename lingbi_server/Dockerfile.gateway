# =============================================================================
# API Gateway 专用 Dockerfile
#
# lingbi_server 是一个 dart_frog 项目（pubspec 依赖 dart_frog ^1.1.0）：
#   - 入口：根目录 main.dart（提供 run()/onRequest）+ routes/index.dart
#   - lib/router.dart 通过 buildRouter() 将 /api/v1/* 代理到各微服务
#
# 构建上下文为 lingbi_server/ 根目录。
# 端口固定 8080（与 docker-compose api-gateway 服务一致）。
# =============================================================================

# ---- Builder 阶段 ----
FROM dart:3.6-sdk AS builder

# 安装 dart_frog_cli 用于 dart_frog build
RUN dart pub global activate dart_frog_cli ^1.1.0
ENV PATH="$PATH:/root/.pub-cache/bin"

WORKDIR /app

# 先复制依赖清单以利用 Docker 层缓存
COPY pubspec.yaml ./

RUN dart pub get

# 复制 Gateway 全部源码（routes/、lib/、main.dart、_middleware.dart 等）
COPY . .

# dart_frog build 生成 build/bin/server.dart，再 AOT 编译为单文件二进制
RUN dart_frog build \
    && cd build \
    && dart pub get \
    && dart compile exe bin/server.dart -o /app/bin/server

# ---- Runtime 阶段 ----
FROM dart:3.6-slim

# 安装 curl 用于健康检查
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*

# 创建非 root 用户
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/bin /app/data && \
    chown -R appuser:appuser /app

WORKDIR /app

USER appuser

# 复制 AOT 编译产物
COPY --from=builder /app/bin/server ./bin/server

ENV PORT=8080
EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["./bin/server"]
