# =========================================
# 灵笔 (Lingbi) 环境变量配置
# =========================================
# 复制本文件为 .env 并根据需要修改值
# cp .env.example .env

# -----------------------------------------
# API Gateway
# -----------------------------------------
API_GATEWAY_PORT=8080

# -----------------------------------------
# 微服务端口
# -----------------------------------------
AI_PROVIDER_PORT=8081
PROJECT_PORT=8082
DOCUMENT_PORT=8083
CANON_PORT=8084
EXPORT_PORT=8085
VERSION_PORT=8086
SETTINGS_PORT=8087
QUOTA_PORT=8088
STORAGE_PORT=8089
SYNC_PORT=8090
CANVAS_PORT=8091

# -----------------------------------------
# 扩展服务端口
# -----------------------------------------
NOVEL_ENGINE_PORT=8092
QUALITY_REVIEW_PORT=8093

# -----------------------------------------
# LiteLLM (AI 模型代理)
# -----------------------------------------
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-12345678

# -----------------------------------------
# AI 模型 API Keys
# -----------------------------------------
SENSENOVA_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------
# Node.js 服务
# -----------------------------------------
NODE_ENV=production

# -----------------------------------------
# Dart Frog
# -----------------------------------------
DART_FROG_DEBUG=false
# 灵笔 API Key 配置示例
# 复制此文件为 .env 并填入你的 API Key
# docker-compose 会自动读取

SENSENOVA_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=