# 灵笔 Docker 环境变量配置
# 复制此文件为 .env 并修改相应配置

# 灵笔配置
LINGBI_VERSION=2.0.0
FLUTTER_CLIENT_ENABLED=true

# LiteLLM
LITELLM_MASTER_KEY=sk-your-litellm-key-here
LITELLM_PORT=4000

# AI Provider (Dart)
AI_PROVIDER_PORT=8081
LITELLM_API_URL=http://litellm:4000

# 各微服务端口
PROJECT_PORT=8082
DOCUMENT_PORT=8083
CODEX_PORT=8084
EXPORT_PORT=8085
VERSION_PORT=8086
SETTINGS_PORT=8087
QUOTA_PORT=8088
STORAGE_PORT=8089
SYNC_PORT=8090
CANVAS_PORT=8091

# API Gateway
API_GATEWAY_PORT=8080

# 数据目录
DATA_DIR=./data

# 调试模式
DEBUG=false