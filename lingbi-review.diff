diff --git a/lib/ui/layout/sidebar/world_tree.dart.bak b/lib/ui/layout/sidebar/world_tree.dart.bak
new file mode 100644
index 0000000..5bc64a2
--- /dev/null
+++ b/lib/ui/layout/sidebar/world_tree.dart.bak
@@ -0,0 +1,180 @@
+import 'package:flutter/material.dart';
+
+import 'package:lingbi/core/di/service_locator.dart';
+import 'package:lingbi/services/world_service.dart';
+import 'package:lingbi/data/database/world_database.dart';
+import 'package:lingbi/ui/theme/wg_components.dart';
+import 'package:lingbi/ui/layout/sidebar/world_tree_item.dart';
+
+class WorldTree extends StatefulWidget {
+  final String worldId;
+  final ValueChanged<String>? onSelectWork;
+  final ValueChanged<String>? onSelectChapter;
+  final ValueChanged<String>? onSelectScene;
+
+  const WorldTree({
+    super.key,
+    required this.worldId,
+    this.onSelectWork,
+    this.onSelectChapter,
+    this.onSelectScene,
+  });
+
+  @override
+  State<WorldTree> createState() => _WorldTreeState();
+}
+
+class _WorldTreeState extends State<WorldTree> {
+  final WorldService _worldService = ServiceLocator.instance.worldService;
+  List<Work> _works = [];
+  Map<String, List<Volume>> _volumes = {};
+  Map<String, List<Chapter>> _chapters = {};
+  Map<String, List<Scene>> _scenes = {};
+  bool _loading = true;
+  String? _expandedWorkId;
+  String? _expandedVolumeId;
+  String? _expandedChapterId;
+  String? _selectedSceneId;
+
+  @override
+  void initState() {
+    super.initState();
+    _loadWorks();
+  }
+
+  Future<void> _loadWorks() async {
+    setState(() => _loading = true);
+    try {
+      _works = await _worldService.getWorks(widget.worldId);
+      if (_works.isNotEmpty) {
+        _expandedWorkId = _works.first.id;
+        await _loadVolumes(_works.first.id);
+      }
+    } catch (_) {}
+    if (mounted) setState(() => _loading = false);
+  }
+
+  Future<void> _loadVolumes(String workId) async {
+    try {
+      _volumes[workId] = await _worldService.volumeRepository.getVolumes(workId, worldId: widget.worldId);
+    } catch (_) {
+      _volumes[workId] = [];
+    }
+  }
+
+  Future<void> _loadChapters(String volumeId) async {
+    try {
+      _chapters[volumeId] = await _worldService.chapterRepository.getChapters(volumeId, worldId: widget.worldId);
+    } catch (_) {
+      _chapters[volumeId] = [];
+    }
+  }
+
+  Future<void> _loadScenes(String chapterId) async {
+    try {
+      _scenes[chapterId] = await _worldService.sceneRepository.getScenesForChapter(chapterId, worldId: widget.worldId);
+    } catch (_) {
+      _scenes[chapterId] = [];
+    }
+  }
+
+  Future<void> _toggleWork(String workId) async {
+    if (_expandedWorkId == workId) {
+      setState(() => _expandedWorkId = null);
+    } else {
+      setState(() => _expandedWorkId = workId);
+      if (_volumes[workId] == null) await _loadVolumes(workId);
+    }
+  }
+
+  Future<void> _toggleVolume(String volumeId) async {
+    if (_expandedVolumeId == volumeId) {
+      setState(() => _expandedVolumeId = null);
+    } else {
+      setState(() => _expandedVolumeId = volumeId);
+      if (_chapters[volumeId] == null) await _loadChapters(volumeId);
+    }
+  }
+
+  Future<void> _toggleChapter(String chapterId) async {
+    if (_expandedChapterId == chapterId) {
+      setState(() => _expandedChapterId = null);
+    } else {
+      setState(() => _expandedChapterId = chapterId);
+      if (_scenes[chapterId] == null) await _loadScenes(chapterId);
+    }
+  }
+
+  void _selectScene(String sceneId) {
+    setState(() => _selectedSceneId = sceneId);
+    widget.onSelectScene?.call(sceneId);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (_loading) {
+      return const Center(child: CircularProgressIndicator(strokeWidth: 2, color: WgTokens.accent));
+    }
+    if (_works.isEmpty) {
+      return Center(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            const Text('📁', style: TextStyle(fontSize: 32)),
+            const SizedBox(height: 8),
+            Text('暂无作品', style: TextStyle(fontSize: 13, color: WgTokens.fg3For(context))),
+            const SizedBox(height: 4),
+            Text('点击 + 新建', style: TextStyle(fontSize: 11, color: WgTokens.fg2For(context))),
+          ],
+        ),
+      );
+    }
+
+    return ListView(
+      padding: const EdgeInsets.symmetric(vertical: 4),
+      children: _works.map((work) => WorldTreeItem<Work>(
+        item: work,
+        depth: 0,
+        isExpanded: _expandedWorkId == work.id,
+        icon: '📁',
+        label: work.title,
+        badge: '${(_volumes[work.id] ?? []).length} 卷',
+        onToggle: () => _toggleWork(work.id),
+        children: _expandedWorkId == work.id
+            ? (_volumes[work.id] ?? []).map((vol) => WorldTreeItem<Volume>(
+                item: vol,
+                depth: 1,
+                isExpanded: _expandedVolumeId == vol.id,
+                icon: '📄',
+                label: vol.title,
+                badge: '${(_chapters[vol.id] ?? []).length} 章',
+                onToggle: () => _toggleVolume(vol.id),
+                children: _expandedVolumeId == vol.id
+                    ? (_chapters[vol.id] ?? []).map((ch) => WorldTreeItem<Chapter>(
+                        item: ch,
+                        depth: 2,
+                        isExpanded: _expandedChapterId == ch.id,
+                        icon: '📝',
+                        label: ch.title,
+                        badge: '${(_scenes[ch.id] ?? []).length} 场',
+                        onToggle: () => _toggleChapter(ch.id),
+                        children: _expandedChapterId == ch.id
+                            ? (_scenes[ch.id] ?? []).map((sc) => WorldTreeItem<Scene>(
+                                item: sc,
+                                depth: 3,
+                                isExpanded: false,
+                                icon: '✏️',
+                                label: sc.title,
+                                isSelected: _selectedSceneId == sc.id,
+                                onTap: () => _selectScene(sc.id),
+                                children: const [],
+                              )).toList()
+                            : const [],
+                      )).toList()
+                    : const [],
+              )).toList()
+            : const [],
+      )).toList(),
+    );
+  }
+}
