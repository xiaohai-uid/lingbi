+        Text(label, style: const TextStyle(fontSize: 11, color: Color(0xFF8A7B68))),
+      ]),
+    );
+  }
+}
+
+extension on int {
+  String toLocaleString() {
+    final s = toString();
+    final b = StringBuffer();
+    for (var i = 0; i < s.length; i++) {
+      if (i > 0 && (s.length - i) % 3 == 0) b.write(',');
+      b.write(s[i]);
+    }
+    return b.toString();
+  }
+}
