+-/// 作品编辑页 — World → Work → Volume → Chapter → Scene 层级编辑器
+-///
+-/// 替代旧的 ProjectPage。
+-/// 左侧 WorldTree 导航，中间编辑器，右侧 AI 面板。
+-class WorkPage extends StatefulWidget {
+-  final World world;
+-
+-  const WorkPage({
+-    super.key,
+-    required this.world,
+-  });
+-
+-  @override
+-  State<WorkPage> createState() => _WorkPageState();
+-}
+-
+-class _WorkPageState extends State<WorkPage> {
+-  final DocumentService _documentService = ServiceLocator.instance.documentService;
+-  final WorldService _worldService = ServiceLocator.instance.worldService;
+-  
+-  Document? _currentDocument;
+-  String _editorContent = '';
+-  bool _saving = false;
+-
+-  @override
+-  Widget build(BuildContext context) {
+-    final theme = Theme.of(context);
+-
+-    final scaffold = Scaffold(
+-      appBar: AppBar(
+-        title: Text(widget.world.name),
+-        bottom: PreferredSize(
+-          preferredSize: const Size.fromHeight(20),
+-          child: Text(_currentDocument?.title ?? '选择一个场景开始写作', style: const TextStyle(fontSize: 12)),
+-        ),
+-        actions: [
+-          if (_saving)
+-            const Padding(
+-              padding: EdgeInsets.symmetric(horizontal: 16),
+-              child: SizedBox(width: 16, height: 16, child: CircularProgressIndicator(strokeWidth: 2)),
+-            )
+-          else ...[
+-            IconButton(icon: const Icon(Icons.auto_stories), tooltip: '知识库 (Canon)', onPressed: _openCodex),
+-            IconButton(icon: const Icon(Icons.account_tree), tooltip: '故事画布', onPressed: _openStoryCanvas),
+-            IconButton(icon: const Icon(Icons.history), tooltip: '版本历史', onPressed: _openVersionHistory),
+-            IconButton(icon: const Icon(Icons.settings), tooltip: '设置', onPressed: () {
+-              Navigator.push(context, MaterialPageRoute(builder: (_) => const SettingsPage()));
+-            }),
+-          ],
+-        ],
+-      ),
+-      body: MainScaffold(
+-        sidebar: WorldTree(
+-          onSceneSelected: _onSceneSelected,
+-          onWorldSelected: (_) {},
+-          onNewWorld: () {
+-            if (mounted) Navigator.pop(context);
+-          },
+-        ),
+-        editor: _currentDocument != null
+-            ? EditorPanel(
+-                initialContent: _editorContent,
+-                documentTitle: _currentDocument?.title,
+-                onSave: _saveCurrentDocument,
+-              )
+-            : _buildWelcomeEditor(theme),
+-        aiPanel: const AIPanel(),
+-      ),
+-    );
+-
+-    return CallbackShortcuts(
+-      bindings: {
+-        const SingleActivator(LogicalKeyboardKey.keyS, control: true): () {
+-          if (_currentDocument != null) _saveCurrentDocument(_editorContent);
+-        },
+-      },
+-      child: Focus(
+-        autofocus: true,
+-        child: scaffold,
+-      ),
+-    );
+-  }
+-
+-  /// 场景被选中 → 加载对应 .md 文档到编辑器
+-  Future<void> _onSceneSelected(String sceneId) async {
+-    try {
+-      final doc = await _documentService.getDocumentBySceneId(sceneId);
+-      if (doc != null) {
+-        await _loadDocument(doc);
+-        return;
+-      }
+-
+-      // 为新场景创建文档
+-      final db = await ServiceLocator.instance.databaseManager.getDefaultDatabase();
+-      final scene = await (db.select(db.scenes)..where((t) => t.id.equals(sceneId))).getSingleOrNull();
+-      if (scene == null) return;
+-
+-      final appDir = await getApplicationDocumentsDirectory();
+-      final sceneDir = Directory('${appDir.path}/灵笔/Worlds/${widget.world.id}/documents');
+-      await sceneDir.create(recursive: true);
+-
+-      final newDoc = await _documentService.createDocument(
+-        projectId: widget.world.id,
+-        sceneId: sceneId,
+-        title: scene.title,
+-        directoryPath: sceneDir.path,
+-        content: '# ${scene.title}\n\n',
+-      );
+-
+-      await _loadDocument(newDoc);
+-    } catch (e) {
+-      if (mounted) {
+-        ScaffoldMessenger.of(context).showSnackBar(
+-          SnackBar(content: Text('打开场景失败: $e'), backgroundColor: Colors.red.shade700),
+-        );
+-      }
+-    }
+-  }
+-
+-  /// 加载文档内容到编辑器
+-  Future<void> _loadDocument(Document doc) async {
+-    try {
+-      final content = await _documentService.readContent(doc.filePath);
+-      if (mounted) {
+-        setState(() {
+-          _currentDocument = doc;
+-          _editorContent = content;
+-        });
+-      }
+-    } catch (e) {
+-      if (mounted) {
+-        ScaffoldMessenger.of(context).showSnackBar(
+-          SnackBar(content: Text('读取失败: $e'), backgroundColor: Colors.red.shade700),
+-        );
+-      }
+-    }
+-  }
+-
+-  /// 保存当前文档
+-  Future<void> _saveCurrentDocument(String content) async {
+-    if (_currentDocument == null || _saving) return;
+-    setState(() => _saving = true);
+-    try {
+-      await _documentService.saveDocument(_currentDocument!, content);
+-      if (mounted) {
+-        ScaffoldMessenger.of(context).showSnackBar(
+-          const SnackBar(content: Text('已保存'), duration: Duration(seconds: 1)),
+-        );
+-      }
+-    } catch (e) {
+-      if (mounted) {
+-        ScaffoldMessenger.of(context).showSnackBar(
+-          SnackBar(content: Text('保存失败: $e'), backgroundColor: Colors.red.shade700),
+-        );
+-      }
+-    } finally {
+-      if (mounted) setState(() => _saving = false);
+-    }
+-  }
+-
+-  void _openCodex() {
+-    Navigator.push(context, MaterialPageRoute(
+-      builder: (_) => CodexPage(worldId: widget.world.id, worldName: widget.world.name),
+-    ));
+-  }
+-
+-  void _openStoryCanvas() {
+-    Navigator.push(context, MaterialPageRoute(
+-      builder: (_) => StoryCanvasPage(worldId: widget.world.id, worldName: widget.world.name),
+-    ));
+-  }
+-
+-  void _openVersionHistory() {
+-    if (_currentDocument == null) {
+-      ScaffoldMessenger.of(context).showSnackBar(
+-        const SnackBar(content: Text('请先打开一个场景')),
+-      );
+-      return;
+-    }
+-    Navigator.push(context, MaterialPageRoute(
+-      builder: (_) => VersionHistoryPanel(
+-        document: _currentDocument!,
+-        projectDir: '',
+-        onRestore: (content) async {
+-          await _saveCurrentDocument(content);
+-          setState(() => _editorContent = content);
+-        },
+-        onRefresh: () {},
+-      ),
+-    ));
+-  }
+-
+-  Widget _buildWelcomeEditor(ThemeData theme) {
+-    return Center(
+-      child: Padding(
+-        padding: const EdgeInsets.all(48),
+-        child: Column(
+-          mainAxisSize: MainAxisSize.min,
+-          children: [
+-            Icon(Icons.menu_book_outlined, size: 48, color: theme.colorScheme.primary),
+-            const SizedBox(height: 24),
+-            Text(widget.world.name, style: theme.textTheme.headlineSmall),
+-            const SizedBox(height: 8),
+-            Text('从左侧选择一个场景开始写作', style: theme.textTheme.bodyLarge),
+-          ],
+-        ),
+-      ),
+-    );
+-  }
+-}
