+    test('parseNames 处理空输入', () {
+      final result = NameGenerator.parseNames('');
+      expect(result, isEmpty);
+    });
+
+    test('parseNames 处理没有分类标记的文本', () {
+      final result = NameGenerator.parseNames('一些随机文本\n没有分类格式');
+      expect(result, isEmpty);
+    });
+  });
