+
+  // ═════════════════════════════════════
+  // 场景摘要 CRUD
+  // ═════════════════════════════════════
+
+  Future<SceneSummary> createSceneSummary({
+    required String sceneId,
+    required String chapterId,
+    required String worldId,
+    required String summary,
+    String keywords = '',
+    String characters = '',
+    String location = '',
