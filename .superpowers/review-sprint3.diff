+  // ═════════════════════════════════════
+  // 卷摘要 CRUD
+  // ═════════════════════════════════════
+
+  Future<VolumeSummary> createVolumeSummary({
+    required String volumeId,
+    required String worldId,
+    required String summary,
+    String status = 'writing',
+    String mainCharacters = '',
+    String storyArc = '',
+    String majorPlotPoints = '',
